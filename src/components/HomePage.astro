---
import Icon from './Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';
import { useTranslations, getTranslationArray, getTranslationObjects } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { getLocalePath } from '../i18n/utils';
import { getCollection } from 'astro:content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const credibility = getTranslationArray(lang, 'home.hero.credibility');
const situations = getTranslationObjects(lang, 'home.howWeHelp.situations');
const steps = getTranslationObjects(lang, 'home.howWeWork.steps');

const lp = (path: string) => getLocalePath(lang, path);

const hreflangUrls = {
  en: 'https://houseofagile.com/',
  de: 'https://houseofagile.com/de/',
  fr: 'https://houseofagile.com/fr/',
};

const services = [
  { key: 'cto', slug: 'fractional-cto-technical-leadership', icon: 'sitemap', color: 'green' },
  { key: 'automation', slug: 'ai-workflow-automation', icon: 'robot', color: 'blue' },
  { key: 'platforms', slug: 'internal-tools-business-platforms', icon: 'cubes', color: 'purple' },
  { key: 'modernization', slug: 'legacy-modernization-system-rescue', icon: 'screwdriver-wrench', color: 'orange' },
  { key: 'product', slug: 'product-delivery-leadership', icon: 'rocket', color: 'cyan' },
  { key: 'devops', slug: 'devops-cloud-platforms', icon: 'cloud', color: 'slate' },
] as const;

type ServiceKey = typeof services[number]['key'];

const securityServices = [
  { key: 'consulting', slug: 'cybersecurity-consulting', icon: 'shield-halved' },
  { key: 'linux', slug: 'secure-linux-workstations', icon: 'laptop-code' },
  { key: 'wifi', slug: 'secure-wifi-network', icon: 'wifi' },
  { key: 'recovery', slug: 'data-recovery', icon: 'hard-drive' },
] as const;

// Link to the localized service page when it exists, otherwise to the English one.
const serviceIds = new Set((await getCollection('services')).map((e) => e.id));
const servicePath = (slug: string) =>
  serviceIds.has(`${lang}/${slug}`) ? lp(`services/${slug}`) : getLocalePath('en', `services/${slug}`);

const caseStudies = [
  {
    slug: 'universal-music-group',
    title: 'Universal Music Group',
    role: { en: 'Delivery Manager', de: 'Delivery Manager', fr: 'Delivery Manager' }[lang] || 'Delivery Manager',
    context: { en: 'Enterprise platform leadership', de: 'Enterprise-Plattform-Leadership', fr: 'Leadership plateforme enterprise' }[lang] || '',
    stat: '120+',
    statLabel: { en: 'Engineers Led', de: 'Ingenieure geleitet', fr: 'Ingénieurs dirigés' }[lang] || 'Engineers Led',
    desc: { en: 'Led the overhaul of Universal\'s global music metadata and delivery systems - managing 120+ engineers across 5 teams in a multi-year SOA transformation.', de: 'Leitete die Überarbeitung von Universals globalen Musik-Metadaten- und Liefersystemen - 120+ Ingenieure in 5 Teams.', fr: 'Direction de la refonte des systèmes de métadonnées musicales d\'Universal - 120+ ingénieurs dans 5 équipes.' }[lang] || '',
    gradient: 'from-indigo-600 to-violet-700',
  },
  {
    slug: 'marketing-automation',
    title: { en: 'Marketing Automation Platform', de: 'Marketing-Automatisierungsplattform', fr: 'Plateforme d\'Automatisation Marketing' }[lang] || 'Marketing Automation Platform',
    role: { en: 'Lead Architect', de: 'Lead Architect', fr: 'Architecte Principal' }[lang] || 'Lead Architect',
    context: { en: 'Full-stack automation platform', de: 'Full-Stack-Automatisierungsplattform', fr: 'Plateforme d\'automatisation full-stack' }[lang] || '',
    stat: '35%',
    statLabel: { en: 'ROI Improvement', de: 'ROI-Verbesserung', fr: 'Amélioration ROI' }[lang] || 'ROI Improvement',
    desc: { en: 'Full-stack Symfony platform with Facebook Event bots, Ad API integration, and automated creative generation. Managed €700k+/month ad budgets with 35% ROI improvement.', de: 'Full-Stack Symfony-Plattform mit Facebook-Event-Bots, Ad-API-Integration und automatisierter Kreativ-Generierung. €700k+/Monat Werbebudgets.', fr: 'Plateforme full-stack Symfony avec bots Facebook Events, intégration Ad API et génération créative automatisée. €700k+/mois de budgets pub.' }[lang] || '',
    gradient: 'from-emerald-600 to-teal-700',
  },
  {
    slug: 'scanbots',
    title: 'Scanbots',
    role: { en: 'Co-founder & CTO', de: 'Mitgründer & CTO', fr: 'Co-fondateur & CTO' }[lang] || 'Co-founder & CTO',
    context: { en: 'Startup CTO & product leadership', de: 'Startup CTO & Produktführung', fr: 'CTO Startup & leadership produit' }[lang] || '',
    stat: '€2M+',
    statLabel: { en: 'Funding Raised', de: 'Finanzierung', fr: 'Financement levé' }[lang] || 'Funding Raised',
    desc: { en: 'Co-founded an autonomous drone platform for infrastructure inspection. Built the technical team, raised €2M+, and processed 200TB+ of sensor data with real-time AI defect detection.', de: 'Mitgründung einer autonomen Drohnenplattform. Team aufgebaut, €2M+ Finanzierung, 200TB+ Sensordaten mit KI-Fehlererkennung.', fr: 'Co-fondation d\'une plateforme de drones autonomes. Équipe technique, €2M+ levés, 200TB+ de données capteur avec détection IA.' }[lang] || '',
    gradient: 'from-cyan-600 to-teal-700',
  },
  {
    slug: 'ai-trading-platform',
    title: { en: 'AI Trading Platform', de: 'KI-Handelsplattform', fr: 'Plateforme de Trading IA' }[lang] || 'AI Trading Platform',
    role: { en: 'Product & Engineering Lead', de: 'Produkt- & Engineering-Lead', fr: 'Lead Produit & Engineering' }[lang] || 'Product & Engineering Lead',
    context: { en: 'AI product engineering', de: 'KI-Produktentwicklung', fr: 'Ingénierie produit IA' }[lang] || '',
    stat: '45%',
    statLabel: { en: 'ROI Increase', de: 'ROI-Steigerung', fr: 'Augmentation ROI' }[lang] || 'ROI Increase',
    desc: { en: 'Designed and built a serverless trading platform with TensorFlow/PyTorch models - from architecture through to production deployment on AWS.', de: 'Entwurf und Bau einer serverlosen Handelsplattform mit TensorFlow/PyTorch - von der Architektur bis zum Produktions-Deployment.', fr: 'Conception et construction d\'une plateforme de trading serverless avec TensorFlow/PyTorch - de l\'architecture au déploiement en production.' }[lang] || '',
    gradient: 'from-purple-600 to-fuchsia-700',
  },
  {
    slug: 'vodafone-live',
    title: 'Vodafone Live!',
    role: { en: 'Technical Lead', de: 'Technical Lead', fr: 'Lead Technique' }[lang] || 'Technical Lead',
    context: { en: 'Enterprise platform at scale', de: 'Enterprise-Plattform im großen Maßstab', fr: 'Plateforme enterprise à grande échelle' }[lang] || '',
    stat: '30M+',
    statLabel: { en: 'Daily Users', de: 'Tägliche Nutzer', fr: 'Utilisateurs/jour' }[lang] || 'Daily Users',
    desc: { en: 'Technical lead on Vodafone\'s mobile content platform serving 30M+ daily users across 15+ European markets with 99.9% uptime.', de: 'Technical Lead der mobilen Content-Plattform von Vodafone mit 30M+ täglichen Nutzern in 15+ europäischen Märkten.', fr: 'Lead technique de la plateforme de contenu mobile Vodafone avec 30M+ utilisateurs quotidiens dans 15+ marchés européens.' }[lang] || '',
    gradient: 'from-rose-600 to-red-700',
  },
  {
    slug: 'gambio-shopify-migration',
    title: { en: 'Gambio to Shopify Migration', de: 'Migration von Gambio zu Shopify', fr: 'Migration Gambio vers Shopify' }[lang] || 'Gambio to Shopify Migration',
    role: { en: 'Freelance Engineer', de: 'Freelance Engineer', fr: 'Ingénieur Freelance' }[lang] || 'Freelance Engineer',
    context: { en: 'E-commerce platform migration', de: 'E-Commerce-Plattform-Migration', fr: 'Migration de plateforme e-commerce' }[lang] || '',
    stat: '0',
    statLabel: { en: 'Launch Downtime', de: 'Ausfallzeit', fr: 'Interruption' }[lang] || 'Launch Downtime',
    desc: { en: 'Six months across dev, DevOps, architecture and product: moved a German Gambio shop to Shopify with JTL-Wawi integration - products, customers, orders and vouchers transferred, SEO preserved.', de: 'Sechs Monate in Entwicklung, DevOps, Architektur und Produkt: deutschen Gambio-Shop mit JTL-Wawi-Anbindung zu Shopify migriert - Produkte, Kunden, Bestellungen und Gutscheine übernommen, SEO erhalten.', fr: 'Six mois en dev, DevOps, architecture et produit : migration d\'une boutique allemande Gambio vers Shopify avec intégration JTL-Wawi - produits, clients, commandes et bons repris, SEO préservé.' }[lang] || '',
    gradient: 'from-orange-500 to-amber-700',
  },
  {
    slug: 'heybuddies',
    title: 'HeyBuddies',
    role: { en: 'Founder & Lead Dev', de: 'Gründer & Lead Dev', fr: 'Fondateur & Lead Dev' }[lang] || 'Founder & Lead Dev',
    context: { en: 'Own product - live platform', de: 'Eigenes Produkt - Live-Plattform', fr: 'Produit propre - plateforme live' }[lang] || '',
    stat: 'Live',
    statLabel: { en: 'In Production', de: 'In Produktion', fr: 'En production' }[lang] || 'In Production',
    desc: { en: 'Built and operate heybuddi.es - a social platform connecting people through shared activities. Symfony, Vue.js, PostgreSQL on AWS.', de: 'Aufbau und Betrieb von heybuddi.es - einer sozialen Plattform. Symfony, Vue.js, PostgreSQL auf AWS.', fr: 'Construction et exploitation de heybuddi.es - une plateforme sociale. Symfony, Vue.js, PostgreSQL sur AWS.' }[lang] || '',
    gradient: 'from-amber-500 to-orange-600',
  },
];

const L = <T,>(o: Record<Lang, T>): T => o[lang];

const heroChecks = [
  { label: L({ en: 'Disk encryption', de: 'Festplattenverschlüsselung', fr: 'Chiffrement du disque' }), value: 'LUKS2' },
  { label: L({ en: 'Wi-Fi', de: 'WLAN', fr: 'Wi-Fi' }), value: 'WPA3 · VLAN' },
  { label: L({ en: 'Backups', de: 'Backups', fr: 'Sauvegardes' }), value: L({ en: 'restore tested', de: 'Restore getestet', fr: 'restauration testée' }) },
  { label: 'PHP', value: L({ en: '8.4.27 · patched', de: '8.4.27 · gepatcht', fr: '8.4.27 · corrigé' }) },
];
const heroStats = [
  { value: '30M+', label: L({ en: 'daily users on platforms we led', de: 'tägliche Nutzer auf von uns geführten Plattformen', fr: 'utilisateurs quotidiens sur nos plateformes' }) },
  { value: '20', label: L({ en: 'years of hands-on delivery', de: 'Jahre praktische Erfahrung', fr: "ans d'expérience terrain" }) },
];
const experienceLabel = L({ en: 'Experience from', de: 'Erfahrung aus', fr: 'Expérience chez' });
const experience = ['Universal Music Group', 'Vodafone', 'Scanbots', 'HeyBuddies'];
const php2shellLabel = L({ en: 'PHP2Shell: how we responded', de: 'PHP2Shell: unsere Reaktion', fr: 'PHP2Shell : notre réponse' });
const pad = (n: number) => String(n + 1).padStart(2, '0');

const localTitle = {
  en: 'House of Agile - Fractional CTO, Automation & Cybersecurity',
  de: 'House of Agile - Senior-Technologieberatung • Workflow-Automatisierung • Fractional CTO',
  fr: 'House of Agile - Conseil Technologique Senior • Automatisation • CTO Fractionnel',
}[lang] || '';

const localDesc = {
  en: 'Senior technology consultancy: fractional CTO, AI workflow automation, custom platforms, cybersecurity consulting, secure Linux setups and data recovery.',
  de: 'House of Agile hilft Unternehmen, Abläufe zu modernisieren, Workflows zu automatisieren und interne Plattformen zu bauen.',
  fr: 'House of Agile aide les entreprises à moderniser leurs opérations, automatiser les workflows et construire des plateformes internes.',
}[lang] || '';
---

<BaseLayout
  title={localTitle}
  description={localDesc}
  lang={lang}
  canonicalUrl={hreflangUrls[lang]}
  hreflangUrls={hreflangUrls}
  schemaType="homepage"
>
  <Navigation lang={lang} />

  <!-- ============ HERO ============ -->
  <section class="px-3 sm:px-4 pt-3">
    <div class="hoa-panel-dark">
      <div class="hoa-aurora hoa-aurora--a"></div>
      <div class="hoa-aurora hoa-aurora--b"></div>

      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-16 pb-10 md:pt-24 md:pb-12">
        <div class="grid lg:grid-cols-12 gap-12 lg:gap-8 items-center">
          <div class="lg:col-span-7">
            <p class="hoa-chip mb-7">
              <span class="hoa-dot"></span>
              {t('home.hero.title')} {t('home.hero.title2')} {t('home.hero.title3')}
            </p>

            <h1 class="hoa-display-xl text-white mb-7">
              {t('home.hero.heading')}
            </h1>

            <p class="text-lg sm:text-xl text-white/60 leading-relaxed max-w-2xl mb-10">
              {t('home.hero.description')}
            </p>

            <div class="flex flex-col sm:flex-row gap-3">
              <a href="#contact" class="btn-primary text-base">
                {t('home.hero.ctaPrimary')}
                <Icon name="arrow-right" class="-rotate-45 text-sm" />
              </a>
              <a href="#services" class="btn-secondary text-base">
                {t('home.hero.ctaSecondary')}
              </a>
            </div>
          </div>

          <!-- Hero bento -->
          <div class="lg:col-span-5" aria-hidden="true">
            <div class="grid grid-cols-2 gap-3">
              <div class="hoa-glass col-span-2 p-5 sm:p-6">
                <div class="flex items-center justify-between mb-5">
                  <span class="hoa-mono text-white/40">security-check</span>
                  <span class="hoa-mono text-green-400">{heroChecks.length}/{heroChecks.length} ok</span>
                </div>
                <ul class="space-y-3">
                  {heroChecks.map((c) => (
                    <li class="flex items-center gap-3 text-sm">
                      <span class="w-5 h-5 rounded-full bg-green-400/15 text-green-400 flex items-center justify-center flex-shrink-0">
                        <Icon name="check" class="text-[10px]" />
                      </span>
                      <span class="text-white/85">{c.label}</span>
                      <span class="flex-1 border-t border-dashed border-white/10"></span>
                      <span class="hoa-mono normal-case tracking-normal text-white/45">{c.value}</span>
                    </li>
                  ))}
                </ul>
              </div>
              {heroStats.map((st) => (
                <div class="hoa-glass p-5 sm:p-6">
                  <div class="text-4xl sm:text-5xl font-bold tracking-tight text-white" style="font-family: var(--font-display)">{st.value}</div>
                  <p class="text-xs sm:text-sm text-white/50 mt-2 leading-snug">{st.label}</p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Experience strip -->
        <div class="mt-14 md:mt-20 pt-6 border-t border-white/10 flex flex-wrap items-center gap-x-8 gap-y-3">
          <span class="hoa-mono text-white/35">{experienceLabel}</span>
          {experience.map((name) => (
            <span class="text-sm sm:text-base font-semibold text-white/55" style="font-family: var(--font-display)">{name}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section id="services" class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
      <div class="reveal grid lg:grid-cols-12 gap-6 mb-12 md:mb-16 items-end">
        <div class="lg:col-span-7">
          <p class="hoa-mono text-green-700 mb-4">01 / {t('home.services.label')}</p>
          <h2 class="hoa-h2 text-gray-900">{t('home.services.title')}</h2>
        </div>
        <p class="lg:col-span-5 text-gray-500 text-lg leading-relaxed">{t('home.services.subtitle')}</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-6 gap-4 stagger-children">
        {services.map((s, i) => {
          const titleKey = `home.services.${s.key}.title` as const;
          const descKey = `home.services.${s.key}.desc` as const;
          return (
            <a href={lp(`services/${s.slug}`)} class:list={['reveal hoa-bento group', ['lg:col-span-4', 'lg:col-span-2', 'lg:col-span-2', 'lg:col-span-4', 'lg:col-span-3', 'lg:col-span-3'][i % 6]]} style={`--i: ${i}`}>
              <div class="flex items-start justify-between mb-10">
                <div class="service-icon service-icon--green">
                  <Icon name={s.icon} />
                </div>
                <span class="hoa-mono text-gray-300">{pad(i)}</span>
              </div>
              <h3 class:list={['font-bold text-gray-900 mb-2 leading-tight tracking-tight', [0, 3].includes(i % 6) ? 'text-2xl sm:text-3xl' : 'text-xl']}>{t(titleKey)}</h3>
              <p class="text-gray-500 text-[0.95rem] leading-relaxed mb-6">{t(descKey)}</p>
              <span class="hoa-arrow mt-auto"><Icon name="arrow-right" class="-rotate-45" /></span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ============ SECURITY ============ -->
  <section id="security" class="px-3 sm:px-4">
    <div class="hoa-panel-dark">
      <div class="hoa-aurora hoa-aurora--c"></div>
      <div class="relative max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 py-16 md:py-24">
        <div class="reveal grid lg:grid-cols-12 gap-6 mb-12 items-end">
          <div class="lg:col-span-7">
            <p class="hoa-mono text-green-400 mb-4">02 / {t('home.security.label')}</p>
            <h2 class="hoa-h2 text-white">{t('home.security.title')}</h2>
          </div>
          <p class="lg:col-span-5 text-white/55 text-lg leading-relaxed">{t('home.security.subtitle')}</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3 stagger-children">
          {securityServices.map((s, i) => (
            <a href={servicePath(s.slug)} class:list={['reveal hoa-glass hoa-glass--link group flex flex-col p-6 sm:p-7', i === 0 ? 'sm:col-span-2 lg:row-span-2' : i === 1 ? 'sm:col-span-2' : '']} style={`--i: ${i}`}>
              <div class="flex items-start justify-between mb-8">
                <div class="w-11 h-11 rounded-2xl bg-green-400/10 border border-green-400/20 text-green-400 flex items-center justify-center text-lg">
                  <Icon name={s.icon} />
                </div>
                <span class="hoa-mono text-white/25">{pad(i)}</span>
              </div>
              <h3 class:list={['font-bold text-white mb-2 leading-tight tracking-tight', i === 0 ? 'text-2xl sm:text-3xl' : 'text-xl']}>{t(`home.security.${s.key}.title` as const)}</h3>
              <p class:list={['text-white/55 leading-relaxed mb-6', i === 0 ? 'text-base max-w-md' : 'text-sm']}>{t(`home.security.${s.key}.desc` as const)}</p>
              {i === 0 && (
                <ul class="grid gap-3 mb-8 mt-2">
                  {getTranslationArray(lang, 'home.security.consulting.items').map((item) => (
                    <li class="flex items-center gap-3 text-sm sm:text-base text-white/80 py-3 border-t border-white/10">
                      <span class="w-5 h-5 rounded-full bg-green-400/15 text-green-400 flex items-center justify-center flex-shrink-0">
                        <Icon name="check" class="text-[10px]" />
                      </span>
                      {item}
                    </li>
                  ))}
                </ul>
              )}
              {i === 0 && (
                <span class="hoa-chip hoa-chip--alert self-start mb-6">
                  <span class="hoa-dot hoa-dot--amber"></span>
                  {php2shellLabel}
                </span>
              )}
              <span class="hoa-arrow hoa-arrow--dark mt-auto"><Icon name="arrow-right" class="-rotate-45" /></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHO THIS IS FOR ============ -->
  <section class="py-20 md:py-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
      <div class="grid lg:grid-cols-12 gap-10">
        <div class="reveal lg:col-span-5">
          <div class="lg:sticky lg:top-28">
            <p class="hoa-mono text-green-700 mb-4">03 / {t('home.howWeHelp.label')}</p>
            <h2 class="hoa-h2 text-gray-900">{t('home.howWeHelp.title')}</h2>
          </div>
        </div>
        <div class="lg:col-span-7">
          {situations.map((sit, i) => (
            <div class="reveal flex gap-5 sm:gap-8 py-7 border-t border-gray-900/10 last:border-b">
              <span class="hoa-mono text-green-700 pt-1.5">{pad(i)}</span>
              <div>
                <h3 class="font-bold text-xl text-gray-900 mb-2 leading-snug tracking-tight">{sit.title}</h3>
                <p class="text-gray-500 leading-relaxed">{sit.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW WE WORK ============ -->
  <section class="pb-20 md:pb-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
      <div class="hoa-panel-light p-7 sm:p-10 lg:p-14">
        <div class="reveal grid lg:grid-cols-12 gap-6 mb-12 items-end">
          <div class="lg:col-span-6">
            <p class="hoa-mono text-green-700 mb-4">04 / {t('home.howWeWork.label')}</p>
            <h2 class="hoa-h2 text-gray-900">{t('home.howWeWork.title')}</h2>
          </div>
          <p class="lg:col-span-6 text-gray-500 text-lg leading-relaxed">{t('home.howWeWork.description')}</p>
        </div>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10 stagger-children">
          {steps.map((step, i) => (
            <div class="reveal border-t-2 border-gray-900 pt-5" style={`--i: ${i}`}>
              <div class="hoa-numeral mb-4">{pad(i)}</div>
              <h3 class="font-bold text-lg text-gray-900 mb-2 tracking-tight">{step.title}</h3>
              <p class="text-gray-500 text-sm leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CASE STUDIES ============ -->
  <section id="case-studies" class="pb-20 md:pb-28">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
      <div class="reveal mb-10 md:mb-14">
        <p class="hoa-mono text-green-700 mb-4">05 / {t('home.caseStudies.label')}</p>
        <h2 class="hoa-h2 text-gray-900">{t('home.caseStudies.title')}</h2>
      </div>

      <div class="border-b border-gray-900/10">
        {caseStudies.map((cs) => (
          <a href={lp(`case-studies/${cs.slug}`)} class="reveal hoa-row group">
            <div class="md:w-[38%] flex-shrink-0">
              <p class="hoa-mono text-green-700 mb-2">{cs.context}</p>
              <h3 class="font-bold text-2xl md:text-[1.7rem] text-gray-900 leading-tight tracking-tight">{cs.title}</h3>
              <p class="text-sm text-gray-400 mt-1">{cs.role}</p>
            </div>
            <p class="flex-1 text-gray-500 leading-relaxed text-[0.95rem]">{cs.desc}</p>
            <div class="md:w-40 flex-shrink-0 md:text-right">
              <div class="hoa-stat">{cs.stat}</div>
              <div class="hoa-mono text-gray-400 mt-1">{cs.statLabel}</div>
            </div>
