---
import Icon from './Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';
import { useTranslations, getTranslationArray, getTranslationObjects } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { getLocalePath } from '../i18n/utils';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang as Lang);
const lp = (path: string) => getLocalePath(lang as Lang, path);

const highlights = getTranslationArray(lang as Lang, 'about.principal.highlights');
const modelItems = getTranslationObjects(lang as Lang, 'about.model.items');
const whyItems = getTranslationArray(lang as Lang, 'about.why.items');

const base = 'https://houseofagile.com';
const hreflangUrls = {
  en: `${base}/about/`,
  de: `${base}/de/about/`,
  fr: `${base}/fr/about/`,
};
const canonicalUrl = lang === 'en' ? hreflangUrls.en : lang === 'de' ? hreflangUrls.de : hreflangUrls.fr;
---

<BaseLayout
  title={t('about.hero.title') + ' - House of Agile'}
  description={t('about.hero.description')}
  lang={lang}
  canonicalUrl={canonicalUrl}
  hreflangUrls={hreflangUrls}
>
  <Navigation lang={lang} />

  <main>
    <!-- Hero -->
    <section class="px-3 sm:px-4 pt-3">
      <div class="hoa-panel-dark">
      <div class="hoa-aurora hoa-aurora--a"></div>
      <div class="relative max-w-4xl mx-auto px-5 py-20 md:py-28">
        <span class="hoa-mono text-green-400 block mb-5">
          {t('about.hero.label')}
        </span>
        <h1 class="hoa-display-xl mb-6">
          {t('about.hero.title')}
        </h1>
        <p class="text-lg md:text-xl text-white/60 max-w-3xl leading-relaxed">
          {t('about.hero.description')}
        </p>
      </div>
      </div>
    </section>

    <!-- Principal section -->
    <section class="py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-4">
        <div class="md:flex md:gap-12 items-start">
          <div class="md:w-1/3 mb-8 md:mb-0">
            <div class="w-32 h-32 md:w-40 md:h-40 rounded-[28px] bg-green-500 flex items-center justify-center text-gray-950 text-4xl md:text-5xl font-bold mx-auto md:mx-0">
              JC
            </div>
          </div>
          <div class="md:w-2/3">
            <h2 class="hoa-h2 text-gray-900 mb-2">
              {t('about.principal.title')}
            </h2>
            <p class="text-hoa-600 font-medium mb-4">
              {t('about.principal.role')}
            </p>
            <p class="text-gray-600 leading-relaxed mb-6">
              {t('about.principal.bio')}
            </p>
            <ul class="space-y-3">
              {highlights.map((item) => (
                <li class="flex items-start gap-3 text-gray-700">
                  <Icon name="check" class="text-hoa-500 mt-1 flex-shrink-0" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- How the practice works -->
    <section class="pb-16 md:pb-24">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="hoa-h2 text-gray-900 mb-5">
          {t('about.model.title')}
        </h2>
        <p class="text-gray-600 leading-relaxed mb-10 max-w-3xl">
          {t('about.model.description')}
        </p>
        <div class="grid md:grid-cols-3 gap-6">
          {modelItems.map((item) => (
            <div class="hoa-bento">
              <h3 class="font-bold text-gray-900 mb-2">{item.title}</h3>
              <p class="text-gray-600 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Why clients work with us -->
    <section class="py-16 md:py-24">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="hoa-h2 text-gray-900 mb-8">
          {t('about.why.title')}
        </h2>
        <ul class="space-y-4">
          {whyItems.map((item) => (
            <li class="flex items-start gap-4 py-5 border-t border-gray-900/10">
              <Icon name="arrow-right" class="text-hoa-500 mt-1 flex-shrink-0" />
              <span class="text-gray-700 leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- CTA -->
    <section class="pb-20">
      <div class="max-w-3xl mx-auto px-4 text-center">
        <h2 class="hoa-h2 text-gray-900 mb-5">
          {t('home.cta.title')}
        </h2>
        <p class="text-gray-600 mb-8 leading-relaxed">
          {t('home.cta.description')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={lp('') + '#contact'} class="btn-primary text-center">
            {t('home.cta.primary')}
          </a>
          <a href={lp('')} class="btn-secondary-light">
            {t('home.cta.secondary')}
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
