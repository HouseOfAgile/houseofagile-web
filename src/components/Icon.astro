---
// Inline SVG icons rendered at build time (no icon font, no client JavaScript).
import {
  faCheck, faArrowRight, faPaperPlane, faLocationDot, faHouse, faEnvelope, faBullseye,
  faArrowUpRightFromSquare, faCloud, faCubes, faHardDrive, faLaptopCode, faRobot, faRocket,
  faScrewdriverWrench, faShieldHalved, faSitemap, faWifi,
} from '@fortawesome/free-solid-svg-icons';
import { faLinkedin } from '@fortawesome/free-brands-svg-icons';

const icons = {
  'check': faCheck,
  'arrow-right': faArrowRight,
  'paper-plane': faPaperPlane,
  'location-dot': faLocationDot,
  'house': faHouse,
  'envelope': faEnvelope,
  'bullseye': faBullseye,
  'arrow-up-right-from-square': faArrowUpRightFromSquare,
  'cloud': faCloud,
  'cubes': faCubes,
  'hard-drive': faHardDrive,
  'laptop-code': faLaptopCode,
  'robot': faRobot,
  'rocket': faRocket,
  'screwdriver-wrench': faScrewdriverWrench,
  'shield-halved': faShieldHalved,
  'sitemap': faSitemap,
  'wifi': faWifi,
  'linkedin': faLinkedin,
} as const;

interface Props {
  name: keyof typeof icons;
  class?: string;
}

const { name, class: className } = Astro.props;
const [width, height, , , path] = icons[name].icon;
const d = Array.isArray(path) ? path.join(' ') : path;
---
<svg class:list={['hoa-icon', className]} viewBox={`0 0 ${width} ${height}`} fill="currentColor" aria-hidden="true" focusable="false"><path d={d} /></svg>
